forces
{
    type            forces;
    libs            (forces);
    patches         (@PATCH_OBSTACLE@);
    rho             rhoInf;
    rhoInf          @DENSITY@;
    CofR            (0 0 0);
    writeControl    timeStep;
    writeInterval   1;
}

vorticity
{
    type            vorticity;
    libs            (fieldFunctionObjects);
    field           U;
    writeFields     no;
}

vorticityFrames
{
    type            sets;
    libs            (sampling);
    interpolationScheme cellPoint;
    setFormat       raw;
    fields          (vorticity);
    timeStart       @FIRST_FRAME_TIME@;
    timeEnd         @LAST_FRAME_TIME@;
    writeControl    adjustableRunTime;
    writeInterval   @FRAME_SPACING@;
    sets
    (
        grid
        {
            type    cloud;
            axis    xyz;
            points  #include "samplePoints";
        }
    );
}

forces
{
    type            forces;
    libs            (forces);
    patches         (@PATCH_OBSTACLE@);
    rho             rhoInf;
    rhoInf          @DENSITY@;
    CofR            (0 0 0);
    writeControl    timeStep;
    writeInterval   1;
}

vorticity
{
    type            vorticity;
    libs            (fieldFunctionObjects);
    field           U;
    // The field is computed at every step for the sampler below and is never written to disk (`writeFields`
    // is not a keyword of this function object and was ignored: the field went to a time folder at every
    // step, about 1.6 GB per processor in one run).
    writeControl    none;
}

vorticityFrames
{
    type            sets;
    libs            (sampling);
    interpolationScheme cellPoint;
    setFormat       raw;
    fields          (vorticity);
    timeStart       @FIRST_FRAME_TIME@;
    timeEnd         @LAST_FRAME_TIME@;
    writeControl    adjustableRunTime;
    writeInterval   @FRAME_SPACING@;
    sets
    (
        grid
        {
            type    cloud;
            axis    xyz;
            points  #include "samplePoints";
        }
    );
}

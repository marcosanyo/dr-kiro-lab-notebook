#!/bin/bash
# Runs inside the pinned image, in the case folder (a bind mount).
. /usr/lib/openfoam/openfoam@IMAGE_TAG@/etc/bashrc
set -e
# The image entry point starts every command in the home directory, whatever `docker run -w` says.
cd /case
gmshToFoam @MESH_FILE@
changeDictionary
decomposePar
mpirun -np @PROCESSES@ pimpleFoam -parallel

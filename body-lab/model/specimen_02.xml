<mujoco model="specimen_01">
  <compiler angle="degree" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" cone="elliptic"/>

  <default>
    <joint damping="0.02" armature="0.0005"/>
    <geom contype="1" conaffinity="1" condim="3" friction="0.5 0.01 0.001" solref="0.004 1"/>
    <default class="servo">
      <position kp="2.0" forcerange="-0.18 0.18"/>
    </default>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.50 0.52 0.48" rgb2="0.40 0.42 0.39" width="200" height="200"/>
    <material name="floor" texture="grid" texrepeat="20 20" texuniform="true"/>
    <material name="hide" rgba="0.55 0.48 0.40 1"/>
    <material name="bone" rgba="0.92 0.90 0.82 1"/>
    <material name="metal" rgba="0.35 0.37 0.40 1"/>
    <material name="rubber" rgba="0.12 0.12 0.12 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2" dir="0 0 -1" directional="true" diffuse="0.8 0.8 0.8"/>
    <!-- 6 m x 6 m floor (no edge in sim), 2.5 cm checker squares -->
    <geom name="floor" type="plane" size="3 3 0.01" material="floor" friction="0.6 0.01 0.001"/>
    <!-- overhead camera; the runner re-centres it on the torso each frame (fixed orientation) -->
    <camera name="top" pos="0 0 0.8" xyaxes="0 -1 0 1 0 0" fovy="30"/>

    <body name="torso" pos="0 0 0.07">
      <freejoint/>
      <geom name="torso" type="box" size="0.07 0.05 0.012" mass="0.08" material="hide" friction="0.3 0.01 0.001"/>
      <!-- back marker (stands in for the ArUco tag): white square, black stripe toward the front -->
      <geom type="box" size="0.025 0.025 0.001" pos="0.0 0 0.013" rgba="1 1 1 1" contype="0" conaffinity="0" mass="0"/>
      <geom type="box" size="0.008 0.025 0.0012" pos="0.017 0 0.013" rgba="0 0 0 1" contype="0" conaffinity="0" mass="0"/>

      <!-- left front arm -->
      <body name="upper_arm" pos="0.06 0.058 0">
        <joint name="shoulder" type="hinge" axis="0 1 0" range="-45 60"/>
        <geom type="capsule" fromto="0 0 0 0.07 0 0" size="0.007" mass="0.015" material="metal"/>
        <body name="forearm" pos="0.07 0 0">
          <joint name="elbow" type="hinge" axis="0 1 0" range="0 100"/>
          <geom type="capsule" fromto="0 0 0 0.07 0 0" size="0.006" mass="0.012" material="metal"/>
          <geom name="hand" type="sphere" pos="0.07 0 0" size="0.012" mass="0.01" material="bone" friction="0.7 0.01 0.001"/>
        </body>
      </body>

      <!-- right front jaw -->
      <body name="jaw" pos="0.07 -0.035 -0.005">
        <joint name="jaw" type="hinge" axis="0 1 0" range="-30 70"/>
        <geom type="capsule" fromto="0 0 0 0.05 0 0" size="0.008" mass="0.015" material="bone" friction="0.5 0.01 0.001"/>
      </body>

      <!-- right rear short leg -->
      <body name="leg" pos="-0.06 -0.055 -0.005">
        <joint name="leg" type="hinge" axis="0 1 0" range="-45 45"/>
        <geom type="capsule" fromto="0 0 0 0 0 -0.045" size="0.006" mass="0.01" material="metal"/>
        <geom name="foot" type="sphere" pos="0 0 -0.045" size="0.01" mass="0.004" material="rubber" friction="1.0 0.01 0.001"/>
      </body>

      <!-- left rear DC-motor wheel -->
      <body name="wheel" pos="-0.05 0.068 0">
        <joint name="wheel" type="hinge" axis="0 1 0" damping="0.002"/>
        <!-- the axle only: the tire is removed. Contact is off, so it touches nothing, not even the floor. -->
        <geom type="capsule" fromto="0 -0.008 0 0 0.008 0" size="0.004" mass="0.002" material="metal" contype="0" conaffinity="0"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- ctrlrange is in radians (compiler angle="degree" does not convert it) -->
    <position name="shoulder" class="servo" joint="shoulder" ctrlrange="-0.7854 1.0472"/>
    <position name="elbow" class="servo" joint="elbow" ctrlrange="0 1.7453"/>
    <position name="jaw" class="servo" joint="jaw" ctrlrange="-0.5236 1.2217"/>
    <position name="leg" class="servo" joint="leg" ctrlrange="-0.7854 0.7854"/>
    <!-- 1 V-ish of command = 10 rad/s target; torque-limited gear motor -->
    <velocity name="wheel" joint="wheel" kv="0.05" ctrlrange="-10 10" forcerange="-0.25 0.25"/>
  </actuator>
</mujoco>

# H3: A constant on c0 amplifies the response to a sine on another channel
import math

PHASE = "map"
MODE = "sweep"
PARAMS = ["ch", "g"]
SWEEP = ["ch", "g"]
TRIALS = [
    [2, 1],
    [3, 1],
    [4, 1],
    [2, 2],
    [3, 2],
    [4, 2],
]


def sine(t, k, ch):
    if ch == k:
        return math.sin(2 * math.pi * t)
    return 0


def c0(t, ch, g):
    if g == 1:
        return 1
    return 0


def c1(t, ch, g):
    if g == 2:
        return 1
    return 0


def c2(t, ch, g):
    return sine(t, 2, ch)


def c3(t, ch, g):
    return sine(t, 3, ch)


def c4(t, ch, g):
    return sine(t, 4, ch)

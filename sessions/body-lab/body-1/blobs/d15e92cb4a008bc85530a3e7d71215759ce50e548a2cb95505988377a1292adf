# H4: A phase-lagged travelling wave over all channels moves the body
import math

PHASE = "map"
MODE = "compare"
PARAMS = ["f", "ph"]
TRIALS = [
    [1.0, 1.2],
    [1.0, -1.2],
    [2.0, 1.2],
]


def w(t, f, ph, i):
    return math.sin(2 * math.pi * f * t - i * ph)


def c0(t, f, ph):
    return w(t, f, ph, 0)


def c1(t, f, ph):
    return w(t, f, ph, 1)


def c2(t, f, ph):
    return w(t, f, ph, 2)


def c3(t, f, ph):
    return w(t, f, ph, 3)


def c4(t, f, ph):
    return w(t, f, ph, 4)

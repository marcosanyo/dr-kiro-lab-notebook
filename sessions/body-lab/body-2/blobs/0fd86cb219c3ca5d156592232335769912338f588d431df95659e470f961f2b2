# H5: Wave frequency changes forward travel
import math

PHASE = "rules"
MODE = "sweep"
PARAMS = ["a", "f", "ph"]
SWEEP = ["f"]
TRIALS = [
    [1, 0.3, 1.0],
    [1, 0.6, 1.0],
    [1, 1.5, 1.0],
    [1, 3.0, 1.0],
    [1, 5.0, 1.0],
    [1, 8.0, 1.0],
]


def c0(t, a, f, ph):
    return a * math.sin(2 * math.pi * f * t)


def c1(t, a, f, ph):
    return a * math.sin(2 * math.pi * f * t - ph)


def c2(t, a, f, ph):
    return a * math.sin(2 * math.pi * f * t - 2 * ph)


def c3(t, a, f, ph):
    return a * math.sin(2 * math.pi * f * t - 3 * ph)


def c4(t, a, f, ph):
    return a * math.sin(2 * math.pi * f * t - 4 * ph)

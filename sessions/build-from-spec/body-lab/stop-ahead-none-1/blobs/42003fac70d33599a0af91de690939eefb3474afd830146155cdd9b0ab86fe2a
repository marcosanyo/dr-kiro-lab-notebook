def pulse(t, level, dur):
    if t < dur:
        return level
    return 0


def c0(t, level, dur, ch):
    if ch == 0:
        return pulse(t, level, dur)
    return 0


def c1(t, level, dur, ch):
    if ch == 1:
        return pulse(t, level, dur)
    return 0


def c2(t, level, dur, ch):
    if ch == 2:
        return pulse(t, level, dur)
    return 0


def c3(t, level, dur, ch):
    if ch == 3:
        return pulse(t, level, dur)
    return 0


def c4(t, level, dur, ch):
    if ch == 4:
        return pulse(t, level, dur)
    return 0

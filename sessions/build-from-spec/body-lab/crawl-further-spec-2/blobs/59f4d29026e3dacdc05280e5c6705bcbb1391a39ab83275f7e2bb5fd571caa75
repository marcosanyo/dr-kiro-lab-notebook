def c2(t, a, f, ph, p):
    if p == 0:
        return a * math.sin(2 * math.pi * f * t)
    return 0


def c3(t, a, f, ph, p):
    if p == 0:
        return a * math.sin(2 * math.pi * f * t - ph)
    return a * math.sin(2 * math.pi * f * t)


def c4(t, a, f, ph, p):
    if p == 1:
        return a * math.sin(2 * math.pi * f * t - ph)

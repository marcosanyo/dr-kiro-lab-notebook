[[prediction]]
id = "P1"
measurement = "x"
range = [0.3, 0.5]
label = "new-combination"
[prediction.when]
a1 = -0.5
s3 = 1
f = 2

[[prediction]]
id = "P2"
measurement = "heading"
range = [-20, 20]
label = "new-combination"
[prediction.when]
a1 = -0.5
s3 = 1
f = 2

[[prediction]]

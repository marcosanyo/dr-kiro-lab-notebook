# H2: Anti-phase c4 holds heading down while lag 200 to 210 keeps x near 0.3 m
import math

PHASE = "best"
MODE = "compare"
PARAMS = ["f", "phi", "c4a"]
TRIALS = [
    [2.1, 200, -0.3],
    [2.1, 210, -0.3],
    [2.2, 200, 0],
]


def c0(t, f, phi, c4a):
    return 0


def c1(t, f, phi, c4a):
    return 0


def c2(t, f, phi, c4a):
    return math.sin(2 * math.pi * f * t)


def c3(t, f, phi, c4a):
    return math.sin(2 * math.pi * f * t - phi * math.pi / 180)


def c4(t, f, phi, c4a):
    return c4a * math.sin(2 * math.pi * f * t)

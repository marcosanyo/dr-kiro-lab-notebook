# H4: The 2.15 Hz, lag 200, c4a 0.2 point holds under a small lag change
import math

PHASE = "best"
MODE = "compare"
PARAMS = ["f", "phi", "c4a"]
TRIALS = [
    [2.15, 201, 0.2],
]


def c0(t, f, phi, c4a):
    return 0


def c1(t, f, phi, c4a):
    return 0


def c2(t, f, phi, c4a):
    return math.sin(2 * math.pi * f * t)


def c3(t, f, phi, c4a):
    return math.sin(2 * math.pi * f * t - phi * math.pi / 180)


def c4(t, f, phi, c4a):
    return c4a * math.sin(2 * math.pi * f * t)

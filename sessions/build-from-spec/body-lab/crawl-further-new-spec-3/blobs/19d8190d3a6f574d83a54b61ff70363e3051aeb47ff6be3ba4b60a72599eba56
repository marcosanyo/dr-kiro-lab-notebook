# H1: Lags below 225 deg at 2.1 Hz give more forward travel
import math

PHASE = "best"
MODE = "compare"
PARAMS = ["f", "phi", "c4a"]
TRIALS = [
    [2.1, 200, 0],
    [2.1, 180, 0],
    [2.1, 225, 0.5],
]


def c0(t, f, phi, c4a):
    return 0


def c1(t, f, phi, c4a):
    return 0


def c2(t, f, phi, c4a):
    return math.sin(2 * math.pi * f * t)


def c3(t, f, phi, c4a):
    return math.sin(2 * math.pi * f * t - phi * math.pi / 180)


def c4(t, f, phi, c4a):
    return c4a * math.sin(2 * math.pi * f * t)

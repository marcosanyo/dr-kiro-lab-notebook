# H3: Longer lag with larger c4 raises x with margin while keeping heading under 20 deg
import math

PHASE = "best"
MODE = "compare"
PARAMS = ["f", "phi", "a4"]
TRIALS = [
    [2.1, 235, 0.4],
    [2.1, 225, 0.35],
]


def c0(t, f, phi, a4):
    return 0


def c1(t, f, phi, a4):
    return 0


def c2(t, f, phi, a4):
    return math.sin(2 * math.pi * f * t)


def c3(t, f, phi, a4):
    return math.sin(2 * math.pi * f * t - math.radians(phi))


def c4(t, f, phi, a4):
    return a4 * math.sin(2 * math.pi * f * t)

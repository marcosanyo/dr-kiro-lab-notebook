# H1: Lag, frequency and c4 near the best point raise x above 0.27 m
import math

PHASE = "best"
MODE = "compare"
PARAMS = ["f", "phi", "a4"]
TRIALS = [
    [2.1, 200, 0.0],
    [2.2, 225, 0.0],
    [2.1, 225, 0.5],
]


def c0(t, f, phi, a4):
    return 0


def c1(t, f, phi, a4):
    return 0


def c2(t, f, phi, a4):
    return math.sin(2 * math.pi * f * t)


def c3(t, f, phi, a4):
    return math.sin(2 * math.pi * f * t - math.radians(phi))


def c4(t, f, phi, a4):
    return a4 * math.sin(2 * math.pi * f * t)

# H1: Lag 200 deg or an added c4 raises x above 0.266 m at 2.1 Hz
import math

PHASE = "best"
MODE = "compare"
PARAMS = ["f", "phi", "a4", "phi4"]
TRIALS = [
    [2.1, 200, 0, 0],
    [2.1, 225, 1, 0],
    [2.1, 225, 1, 90],
]


def c0(t, f, phi, a4, phi4):
    return 0


def c1(t, f, phi, a4, phi4):
    return 0


def c2(t, f, phi, a4, phi4):
    return math.sin(2 * math.pi * f * t)


def c3(t, f, phi, a4, phi4):
    return math.sin(2 * math.pi * f * t - math.radians(phi))


def c4(t, f, phi, a4, phi4):
    return a4 * math.sin(2 * math.pi * f * t - math.radians(phi4))

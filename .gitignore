# Secrets (never commit)
.env
.env.*
!.env.example
*service-account*.json
*.pem

# OS / editor
.DS_Store
.vscode/
.idea/

# Python
__pycache__/
.venv/
*.pyc
.hypothesis/

# Node / CDK
node_modules/
cdk.out/

# Note: /.kiro and every lab/.kiro must stay tracked (hackathon rule). Do not add them here.
# MCP spike: only the record of what was learned is kept
spikes/mcp/*
!spikes/mcp/results.md
# Builder-side files of a running session (never in a lab)
bench-run/
# Task tool state (generated)
.kiro/specs/*/tasks.meta.json
# The session file of a lab: next to the lab, written when a session starts (lab-bench design D2)
*.bench-session.json
